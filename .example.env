BETTER_AUTH_SECRET=
BETTER_AUTH_URL=
DATABASE_URL=

GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

EMAIL_SERVICE_URL=
EMAIL_SERVICE_API_KEY=

# SMTP email configuration (used by sendEmailSMTP in lib/email.ts)
# Uncomment these and set values to enable direct SMTP email sending.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=false  # true for SSL/TLS, false for STARTTLS/plain

# Feature flags
# Set to 'false' to allow signup without verifying email (default: true)
EMAIL_REQUIRED_FOR_SIGNUP=true
